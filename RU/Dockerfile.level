# Один образ на все уровни. Набор инструментов задаётся через EXTRA_PKGS,
# поэтому на каждом уровне «есть одно, но нет другого».
FROM debian:12-slim
ARG LEVEL
ARG EXTRA_PKGS=""
ENV LEVEL=${LEVEL}
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server ca-certificates ${EXTRA_PKGS} && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /run/sshd /task && \
    useradd -m -s /bin/bash "level${LEVEL}"
COPY level/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
